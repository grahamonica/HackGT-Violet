# VioletReferent test credentials (used only by this package's tests; the app
# reads the repo-root .env). Copy to .env (gitignored) and fill in.
#
# Demo setup: one IAM user with full Rekognition access, used for both search
# and enrollment. Delete the key after the event. Never commit .env.
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=
